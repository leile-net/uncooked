// Copy this file to arduino_secrets.h and fill it in. Do not commit the copy.

#define SECRET_SSID "your-wifi"
#define SECRET_PASS "your-wifi-password"

// Host only, no https:// and no path. Example: abcdefgh.supabase.co
#define SECRET_HOST "your-project.supabase.co"

// Project Settings → API → anon public key. The ingest function also checks the device secret.
#define SECRET_ANON_KEY "your-anon-key"

// select secret from devices;  — the row created when you signed up.
#define SECRET_DEVICE_SECRET "paste-from-devices-table"
